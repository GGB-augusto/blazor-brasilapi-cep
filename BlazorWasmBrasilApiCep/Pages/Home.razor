@page "/"
@using System.Net.Http.Json
@using BlazorWasmBrasilApiCep.Models
@inject HttpClient Http

<PageTitle>Consulta CEP - BrasilAPI</PageTitle>

<h1>Consulta de CEP com Blazor WebAssembly</h1>

<div class="row mb-3">
    <div class="col-md-4">
        <label class="form-label">Digite o CEP:</label>
        <input class="form-control" @bind="cepDigitado" placeholder="Ex: 01001000" />
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button class="btn btn-primary w-100" @onclick="ConsultarCep">Consultar</button>
    </div>
</div>

@if (erro != "")
{
    <p style="color: red;">@erro</p>
}

@if (resultado != null)
{
    <div class="card p-3">
        <h3 class="text-success">Endereço Encontrado</h3>
        <p><b>CEP:</b> @resultado.cep</p>
        <p><b>Logradouro:</b> @resultado.street</p>
        <p><b>Bairro:</b> @resultado.neighborhood</p>
        <p><b>Cidade:</b> @resultado.city (@resultado.state)</p>
        <p><b>Serviço:</b> @resultado.service</p>

        <hr />

        <h5 class="text-secondary">Dados do IBGE</h5>
        <p><b>Cidade IBGE:</b> @resultado.ibge.city</p>
        <p><b>Estado IBGE:</b> @resultado.ibge.state</p>
    </div>
}

@code {
    private string cepDigitado = "";
    private Cep? resultado;
    private string erro = "";

    private async Task ConsultarCep()
    {
        erro = "";
        resultado = null;

        if (cepDigitado == "")
        {
            erro = "Digite um CEP.";
            return;
        }

        try
        {
            // junta o endereco base com o cep digitado
            resultado = await Http.GetFromJsonAsync<Cep>("api/cep/v1/" + cepDigitado);
        }
        catch
        {
            erro = "CEP não encontrado. Confira e tente de novo.";
        }
    }
}